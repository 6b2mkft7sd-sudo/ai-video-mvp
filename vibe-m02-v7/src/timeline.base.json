    {"id": "s1", "start": 0.25, "end": 1.85, "text": "小「她眼睛红了。」"},
    {"id": "s2a", "start": 2.05, "end": 4.15, "text": "大「你问：怎么了？」"},
    {"id": "s2b", "start": 2.6, "end": 4.15, "text": "大「要不要我帮你弄？」"},
    {"id": "s4", "start": 4.7, "end": 6.45, "text": "大「她摇头，不说话了。」"},
    {"id": "s5", "start": 6.65, "end": 8.05, "text": "大「你急着把事弄好。」"},
    {"id": "s6", "start": 8.25, "end": 9.65, "text": "小「她只想你先坐下来。」"},
    {"id": "s7a", "start": 9.85, "end": null, "text": "大「于是两个人都觉得：」"},
    {"id": "s7b", "start": 10.4, "end": null, "text": "大「对方不在乎。」悬到片尾"}
